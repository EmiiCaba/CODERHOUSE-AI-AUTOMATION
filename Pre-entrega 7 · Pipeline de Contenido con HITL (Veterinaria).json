      "parameters": {
        "jsCode": "const idea = $('Buscar idea nueva').first().json;\nconst contexto = $input.all()\n  .map(i => `- ${i.json['Tema']}: ${i.json['Contenido']}`)\n  .join('\\n');\nreturn [{ json: { recordId: idea.id, idea: idea['Idea Semilla'], contexto } }];"
      },
